# Copy this file to `.env` to change any of these. Everything is optional.

# Your Kie.ai key (https://kie.ai/api-key). Easier: paste it in the banner the app shows on first start,
# or in Advanced → Settings. A key saved there wins over this one.
# KIE_API_KEY=

# Ports: the page (WEB_PORT) and the local API server (PORT).
# WEB_PORT=5173
# PORT=8787

# Don't open the browser when the app starts.
# OPEN_BROWSER=0

# Where things are kept (defaults are inside this folder).
# TRENCHABLE_DATA=data/studio        # elements, projects, uploads, local-tool runs
# STUDIO_DB_PATH=data/studio.db      # the history database
# TRENCHABLE_TOOLS=extras/local-tools   # optional local GPU tools (extras/local-tools/README.md)
# TRENCHABLE_VOICE=extras/voice         # optional Voice change / Translate (extras/voice/README.md)

# Optional AI keys for the prompt helper, translation and Advanced's agent. You can also add them in
# Advanced → Settings → AI.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# Model catalogue sync on server start (default: on, skipped if less than 12 hours old)
# SYNC_MODELS_ON_START=0

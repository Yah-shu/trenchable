# Trenchable Team settings.
# Put each value right after the "=" with no spaces or quotes.
# Comments sit on their own lines, so this file can be pasted straight into Vercel.

# ── AI providers ─────────────────────────────────────────────
# Kie.ai API key. Kie runs every model, and jobs are paid from your Kie credits.
# No account yet? Sign up at https://kie.ai?ref=d63ec5bbbb733f26cd5d4ced27d29ee0
# then copy your key from https://kie.ai/api-key?ref=d63ec5bbbb733f26cd5d4ced27d29ee0
KIE_API_KEY=
# Optional. ElevenLabs API key for voiceovers (elevenlabs.io/app/settings/api-keys).
# Uses your own ElevenLabs plan and voice library, cloned voices included.
ELEVENLABS_API_KEY=
# Optional. Google Gemini API key, a backup for Nano Banana and Omni Flash (aistudio.google.com/apikey).
GOOGLE_AI_API_KEY=
# Set to "on" to send failed Kie jobs for those models to Google. Leave empty (off) until billing works on the Google key.
GOOGLE_BACKUP=

# ── Supabase (Project Settings → API Keys) ───────────────────
# Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (or the older anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (or the older service_role key). Never share this.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────
# A long random string, e.g. from `openssl rand -hex 32`. Don't change it once API keys exist, or they stop working.
API_SECRET_SALT=
# Leave empty on Vercel's own address; set it when you use a custom domain.
NEXT_PUBLIC_APP_URL=
# Time zone for the day boundaries on the Spend page.
SPEND_TIMEZONE=America/New_York
# Most each API key (Claude / scripts) can spend in any 24 hours, in USD. Empty = 500; "off" = no limit.
API_DAILY_SPEND_CAP_USD=
# Days generated files are kept before the daily cleanup deletes them. Empty = 7; "off" = keep everything.
# Cards, prompts and costs are always kept, and uploaded reference files are never deleted.
RETENTION_DAYS=
# Any long random string. The daily jobs (status check + cleanup) need it; set the same value in Vercel.
CRON_SECRET=
